ros2_ws/src/moveit_hybrid_planning/
ros2_ws/src/mujoco_menagerie_sparse/
ros2_ws/src/mujoco_ros2_control/

# Vendored MuJoCo Menagerie FR3 asset dump (meshes/textures/LICENSE/README
# copied in verbatim, not authored here) -- large binary third-party content.
ros2_ws/src/fr3_mujoco_bringup/mujoco_models/

# Staged MuJoCo SDK (Phase 0/1 infra work) -- large build artifacts.
mujoco_sdk/

# Standalone companion benchmark repo (yycao68/predictive-realizability),
# published separately so it's citable independent of this paper repo --
# has its own git history/remote, not tracked here.
predictive-realizability/

